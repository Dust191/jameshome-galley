# staging 环境变量模板。复制到 /opt/galley/infra/compose/.env.staging 并 chmod 600 后逐项填写。
#
# 与 .env.prod.example 的差异只有四处：环境名、库口令、日志级别、镜像 tag 可不同。
# 其余变量必须齐备——compose 对 GALLEY_IMAGE_TUNNEL 用了必填校验，缺了连 config 都过不去。
#
# 三条约定同生产：含空格的值加双引号；文件必须是 LF 行尾；填好的文件不得入库。

GALLEY_ENV=staging

# ---- 数据库：服务名 db 指向 staging 自己的 db 容器，与 prod 数据卷互不相通 ----
GALLEY_DB_URL=jdbc:postgresql://db:5432/galley
GALLEY_DB_USERNAME=galley
GALLEY_DB_PASSWORD=change-me-staging

# ---- 对象存储：读写走内网 endpoint，图片地址用公网 endpoint 签名 ----
# 独立 bucket：deploy.md §2 要求 staging 与 prod 不共用桶，因此这里换成 -staging 后缀
GALLEY_S3_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
GALLEY_S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
GALLEY_S3_REGION=cn-hangzhou
GALLEY_S3_BUCKET=jameshome-galley-staging
GALLEY_S3_ACCESS_KEY=change-me
GALLEY_S3_SECRET_KEY=change-me
GALLEY_S3_SIGNED_URL_TTL_SECONDS=3600

# ---- 镜像：与 prod 同 tag，保证「同镜像」这一条成立 ----
GALLEY_IMAGE_API=ghcr.io/dust191/galley-api:0.2.1
GALLEY_IMAGE_WEB=ghcr.io/dust191/galley-web:0.2.1
GALLEY_IMAGE_CADDY=crpi-8wtwv1zju2g9kpgg.cn-hangzhou.personal.cr.aliyuncs.com/jameshome-galley/caddy:2-alpine
GALLEY_IMAGE_TUNNEL=crpi-8wtwv1zju2g9kpgg.cn-hangzhou.personal.cr.aliyuncs.com/jameshome-galley/cloudflared:2026.10.7

# ---- 运行参数 ----
GALLEY_LOG_LEVEL=debug
# 与 prod 的 02:30 错开，避免两套对账在同一时段争 CPU 与磁盘；含空格，必须加引号
GALLEY_RECONCILE_CRON="0 30 3 * * *"
