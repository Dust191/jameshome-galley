# 生产环境变量模板。复制到 /opt/galley/.env.prod 并 chmod 600 后逐项填写。
#
# 三条约定（都踩过）：
#   1) 含空格的值必须加双引号，尤其 cron 表达式。不加引号时，任何脚本 source 本文件
#      都会把值当命令执行，且其后的变量全部变成空值，报错却只显示 "30: command not found"。
#   2) 文件必须是 LF 行尾。从 Windows 直接传过来的文件带 CRLF，值尾会多一个 \r：
#      compose 能容忍，shell 与 ossutil 不能，表现是莫名其妙的 "invalid oss path"。
#   3) 本模板不含任何真实凭据；填好的 .env.prod 不得提交进仓库（.gitignore 已覆盖）。
#
# 校验：docker compose --env-file .env.prod -f infra/compose/compose.prod.yml config -q

GALLEY_ENV=prod

# ---- 数据库：服务名 db，库名固定 galley ----
GALLEY_DB_URL=jdbc:postgresql://db:5432/galley
GALLEY_DB_USERNAME=galley
GALLEY_DB_PASSWORD=change-me

# ---- 对象存储：后端读写走内网 endpoint，图片地址用公网 endpoint 签名 ----
GALLEY_S3_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
GALLEY_S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
GALLEY_S3_REGION=cn-hangzhou
GALLEY_S3_BUCKET=jameshome-galley
GALLEY_S3_ACCESS_KEY=change-me
GALLEY_S3_SECRET_KEY=change-me
GALLEY_S3_SIGNED_URL_TTL_SECONDS=3600

# ---- 镜像：固定 tag，禁止 latest；api / web 与 pom.xml 版本对齐 ----
GALLEY_IMAGE_API=ghcr.io/dust191/galley-api:0.2.0
GALLEY_IMAGE_WEB=ghcr.io/dust191/galley-web:0.2.0
GALLEY_IMAGE_CADDY=crpi-8wtwv1zju2g9kpgg.cn-hangzhou.personal.cr.aliyuncs.com/jameshome-galley/caddy:2-alpine
GALLEY_IMAGE_TUNNEL=crpi-8wtwv1zju2g9kpgg.cn-hangzhou.personal.cr.aliyuncs.com/jameshome-galley/cloudflared:2026.10.7

# ---- 运行参数 ----
GALLEY_LOG_LEVEL=info
# 六个字段的 cron：秒 分 时 日 月 周；含空格，必须加引号
GALLEY_RECONCILE_CRON="0 30 2 * * *"
