# jameshome-galley 环境变量样例
# 规则：本文件入库；真实 .env 永不入库。变量名与 application.yml 中 ${...} 的引用一一对应，
#      CI 执行 scripts/check-env-example.sh 校验一致性，新增变量必须同时改两处。

# 运行环境：dev | prod。prod 时关闭调试日志、开启安全响应头校验
GALLEY_ENV=dev

# HTTP 监听端口，容器内固定 8080
GALLEY_SERVER_PORT=8080

# 数据库连接。开发环境指向 compose.dev.yml 起的 PostgreSQL 18
GALLEY_DB_URL=jdbc:postgresql://localhost:5432/galley
GALLEY_DB_USERNAME=galley
GALLEY_DB_PASSWORD=galley

# 日志级别：info | debug。prod 必须为 info
GALLEY_LOG_LEVEL=info

# 对象存储（开发环境为虚拟机内 MinIO，见 ADR-0005）。secret 不得写入仓库
GALLEY_S3_ENDPOINT=http://127.0.0.1:9000
GALLEY_S3_ACCESS_KEY=galley
GALLEY_S3_SECRET_KEY=galley123
GALLEY_S3_BUCKET=galley-material
GALLEY_S3_PUBLIC_BASE=http://127.0.0.1:9000/galley-material
# 图片大小上限，默认 5 MB
GALLEY_S3_MAX_IMAGE_BYTES=5242880

# 初始管理员：库为空时创建一次。口令留空则生成 16 位随机口令并打印到日志，首次登录强制改密
GALLEY_BOOTSTRAP_ADMIN_USERNAME=admin
GALLEY_BOOTSTRAP_ADMIN_PASSWORD=
